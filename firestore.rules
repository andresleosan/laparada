rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth()
        && request.auth.token.email == 'andres.san1404@gmail.com';
    }

    function userProfilePath() {
      return /databases/$(database)/documents/usuarios_negocio/$(request.auth.uid);
    }

    function hasProfileForTenant(negocioId) {
      return isAuth()
        && exists(userProfilePath())
        && get(userProfilePath()).data.activo == true
        && get(userProfilePath()).data.negocioId == negocioId;
    }

    function tenantIsActive(negocioId) {
      return negocioId == 'laparada'
        || (
          exists(/databases/$(database)/documents/negocios/$(negocioId))
          && get(/databases/$(database)/documents/negocios/$(negocioId)).data.estado == 'activo'
        );
    }

    function isTenantMember(negocioId) {
      return isSuperAdmin()
        || (hasProfileForTenant(negocioId) && tenantIsActive(negocioId));
    }

    function isTenantAdmin(negocioId) {
      return isSuperAdmin()
        || (
          isTenantMember(negocioId)
          && get(userProfilePath()).data.rol == 'admin'
        );
    }

    function isValidTenantId(negocioId) {
      return negocioId is string
        && negocioId.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function hasTenant(data) {
      return data.keys().hasAll(['negocioId'])
        && isValidTenantId(data.negocioId);
    }

    function canCreateTenantDocument() {
      return hasTenant(request.resource.data)
        && isTenantMember(request.resource.data.negocioId);
    }

    function canReadTenantDocument() {
      return hasTenant(resource.data)
        && isTenantMember(resource.data.negocioId);
    }

    function canUpdateTenantDocument() {
      return hasTenant(resource.data)
        && hasTenant(request.resource.data)
        && request.resource.data.negocioId == resource.data.negocioId
        && isTenantMember(resource.data.negocioId);
    }

    function canDeleteTenantDocument() {
      return hasTenant(resource.data)
        && isTenantMember(resource.data.negocioId);
    }

    function canAdminCreateTenantDocument() {
      return hasTenant(request.resource.data)
        && isTenantAdmin(request.resource.data.negocioId);
    }

    function canAdminUpdateTenantDocument() {
      return hasTenant(resource.data)
        && hasTenant(request.resource.data)
        && request.resource.data.negocioId == resource.data.negocioId
        && isTenantAdmin(resource.data.negocioId);
    }

    function canAdminDeleteTenantDocument() {
      return hasTenant(resource.data)
        && isTenantAdmin(resource.data.negocioId);
    }

    // Menú público; toda escritura queda aislada por negocio.
    match /productos/{productoId} {
      allow read: if true;
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /combos/{comboId} {
      allow read: if true;
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    // Perfil y negocio: lectura pública de negocios activos, o lectura
    // administrativa y propia. El alta pública solo puede crear un negocio
    // pendiente y su perfil propietario correspondiente.
    match /negocios/{negocioId} {
      allow read: if resource.data.estado == 'activo'
        || isSuperAdmin()
        || hasProfileForTenant(negocioId)
        || (
          isAuth()
          && resource.data.propietarioEmail == request.auth.token.email
        );

      allow create: if isSuperAdmin()
        || (
          isAuth()
          && isValidTenantId(negocioId)
          && request.resource.data.id == negocioId
          && request.resource.data.propietarioEmail == request.auth.token.email
          && request.resource.data.estado == 'pendiente'
        )
        || (
          negocioId == 'laparada'
          && isTenantAdmin(negocioId)
          && request.resource.data.keys().hasOnly([
            'nombre', 'telefono', 'ciudad', 'direccion', 'logoUrl', 'actualizadoEn',
            'recibirResumenDiarioEmail', 'emailNotificacionesResumen', 'configHorarios'
          ])
          && (!('configHorarios' in request.resource.data) || request.resource.data.configHorarios is map)
        );

      allow delete: if isSuperAdmin();

      allow update: if isSuperAdmin()
        || (
          isTenantAdmin(negocioId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombre', 'telefono', 'ciudad', 'direccion', 'logoUrl', 'actualizadoEn',
            'recibirResumenDiarioEmail', 'emailNotificacionesResumen', 'configHorarios'
          ])
          && (!('configHorarios' in request.resource.data) || request.resource.data.configHorarios is map)
        );
    }

    match /usuarios_negocio/{uid} {
      allow read: if isSuperAdmin()
        || (isAuth() && request.auth.uid == uid)
        || (
          resource.data.keys().hasAll(['negocioId'])
          && isTenantAdmin(resource.data.negocioId)
        );

      // Alta inicial de propietario o administración por SuperAdmin
      allow create: if isSuperAdmin()
        || (
          isAuth()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.rol == 'admin'
          && request.resource.data.activo == true
        );

      allow update: if isSuperAdmin()
        || (
          resource.data.keys().hasAll(['negocioId'])
          && isTenantAdmin(resource.data.negocioId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.negocioId == resource.data.negocioId
          && request.resource.data.creadoEn == resource.data.creadoEn
          && request.resource.data.rol in ['admin', 'cajero', 'domiciliario', 'cocinero']
        );

      allow delete: if isSuperAdmin()
        || (
          resource.data.keys().hasAll(['negocioId'])
          && isTenantAdmin(resource.data.negocioId)
        );
    }

    match /ventas/{ventaId} {
      allow read: if canReadTenantDocument();
      // La identidad canónica es ventaId; nunca se duplica como dato mutable.
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id']);
      allow update: if canAdminUpdateTenantDocument()
        && !request.resource.data.keys().hasAny(['id']);
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /domicilios/{domicilioId} {
      // Los pedidos públicos entran exclusivamente por crearPedidoPublico (Admin SDK).
      // Se conserva la creación directa para el POS interno y autopedidos a mesa en salón.
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        || (
          hasTenant(request.resource.data)
          && tenantIsActive(request.resource.data.negocioId)
          && request.resource.data.origen == 'pos'
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.keys().hasAll(['negocioId', 'items', 'total', 'estado'])
        );
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /reservas/{reservaId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /cotizaciones/{cotizacionId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id']);
      allow update: if canUpdateTenantDocument()
        && !request.resource.data.keys().hasAny(['id']);
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /clientes/{clienteId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /cuentas_corrientes/{cuentaId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.cupoCredito is number
        && request.resource.data.cupoCredito >= 0
        && request.resource.data.saldoActual is number
        && request.resource.data.saldoActual >= 0;
      allow update: if canUpdateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.cupoCredito is number
        && request.resource.data.cupoCredito >= 0
        && request.resource.data.saldoActual is number
        && request.resource.data.saldoActual >= 0;
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /movimientos_cartera/{movimientoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.monto is number
        && request.resource.data.monto > 0;
      allow update: if false;
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /bonos_prepago/{bonoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() >= 4
        && request.resource.data.codigo.size() <= 40
        && request.resource.data.tipo in ['bono_regalo', 'tarjeta_prepago', 'vale_consumo']
        && request.resource.data.estado in ['activo', 'agotado', 'bloqueado', 'anulado']
        && request.resource.data.metodoPagoEmision in ['efectivo', 'transferencia']
        && request.resource.data.montoInicial is number
        && request.resource.data.montoInicial > 0
        && request.resource.data.saldoActual is number
        && request.resource.data.saldoActual >= 0;
      allow update: if canUpdateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.codigo == resource.data.codigo
        && request.resource.data.montoInicial == resource.data.montoInicial
        && request.resource.data.estado in ['activo', 'agotado', 'bloqueado', 'anulado']
        && request.resource.data.saldoActual is number
        && request.resource.data.saldoActual >= 0;
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /movimientos_bonos/{movimientoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.tipo in ['emision', 'recarga', 'redencion', 'ajuste_saldo', 'bloqueo', 'desbloqueo', 'anulacion']
        && request.resource.data.monto is number
        && request.resource.data.monto >= 0
        && (!(request.resource.data.tipo in ['emision', 'recarga', 'redencion']) || request.resource.data.monto > 0)
        && request.resource.data.saldoPrevio is number
        && request.resource.data.saldoPrevio >= 0
        && request.resource.data.saldoResultante is number
        && request.resource.data.saldoResultante >= 0;
      allow update: if false;
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /mesas/{mesaId} {
      allow read: if canReadTenantDocument()
        || tenantIsActive(resource.data.negocioId);
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument()
        || (
          hasTenant(resource.data)
          && hasTenant(request.resource.data)
          && request.resource.data.negocioId == resource.data.negocioId
          && tenantIsActive(resource.data.negocioId)
          && (
            (
              request.resource.data.estado in ['ocupada', 'por_cobrar']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'negocioId', 'estado', 'cuentaActivaId', 'comensales',
                'totalActual', 'apertura', 'llamadoPendiente', 'actualizadoEn'
              ])
            )
            || (
              request.resource.data.estado == resource.data.estado
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'negocioId', 'llamadoPendiente', 'actualizadoEn'
              ])
            )
          )
        );
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /cuentas_mesas/{cuentaId} {
      allow read: if canReadTenantDocument()
        || tenantIsActive(resource.data.negocioId);
      allow create: if canCreateTenantDocument()
        || (
          hasTenant(request.resource.data)
          && tenantIsActive(request.resource.data.negocioId)
          && request.resource.data.estado == 'abierta'
          && request.resource.data.total == 0
        );
      allow update: if canUpdateTenantDocument()
        || (
          hasTenant(resource.data)
          && hasTenant(request.resource.data)
          && request.resource.data.negocioId == resource.data.negocioId
          && tenantIsActive(resource.data.negocioId)
          && request.resource.data.estado in ['abierta', 'por_cobrar']
          && request.resource.data.total is number
          && resource.data.total is number
          && request.resource.data.total >= resource.data.total
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'negocioId', 'rondas', 'items', 'total', 'estado', 'actualizadoEn'
          ])
        );
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /notificaciones_correo/{notificacionId} {
      allow read: if canReadTenantDocument();
      allow create: if false;
      allow update: if false;
      allow delete: if canAdminDeleteTenantDocument();
    }

    // Proyección pública de seguimiento en vivo del pedido para el cliente sin login.
    // Solo lectura pública del token individual; la escritura se realiza exclusivamente con Admin SDK.
    match /rastreo_pedidos/{token} {
      allow read: if true;
      allow write: if false;
    }

    // Estado interno exclusivo de la Function de pedidos públicos.
    match /_idempotencia_pedidos_publicos/{registroId} {
      allow read, write: if false;
    }

    match /_limites_pedidos_publicos/{registroId} {
      allow read, write: if false;
    }

    match /_limites_whatsapp_manual/{registroId} {
      allow read, write: if false;
    }

    match /_conversaciones_whatsapp/{conversacionId} {
      allow read, write: if false;
    }

    match /inventario/{insumoId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /entradas_inventario/{entradaId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    function isValidLoteInventarioComun() {
      return request.resource.data.cantidadConsumida is number
        && request.resource.data.cantidadConsumida >= 0
        && request.resource.data.estado in ['activo', 'agotado', 'vencido_baja', 'cuarentena']
        && (
          !('fechaVencimiento' in request.resource.data)
          || request.resource.data.fechaVencimiento == null
          || (
            request.resource.data.fechaVencimiento is string
            && request.resource.data.fechaVencimiento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          )
        );
    }

    match /lotes_inventario/{loteId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.insumoId is string
        && request.resource.data.insumoId.size() >= 1
        && request.resource.data.insumoId.size() <= 128
        && request.resource.data.insumoNombre is string
        && request.resource.data.insumoNombre.size() >= 1
        && request.resource.data.insumoNombre.size() <= 200
        && request.resource.data.codigoLote is string
        && request.resource.data.codigoLote.size() >= 2
        && request.resource.data.codigoLote.size() <= 64
        && request.resource.data.cantidadInicial is number
        && request.resource.data.cantidadInicial > 0
        && request.resource.data.cantidadDisponible is number
        && request.resource.data.cantidadDisponible >= 0
        && request.resource.data.cantidadDisponible <= request.resource.data.cantidadInicial
        && request.resource.data.costoUnitario is number
        && request.resource.data.costoUnitario >= 0
        && isValidLoteInventarioComun();
      allow update: if canUpdateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.insumoId == resource.data.insumoId
        && request.resource.data.codigoLote == resource.data.codigoLote
        && request.resource.data.cantidadInicial == resource.data.cantidadInicial
        && request.resource.data.cantidadDisponible is number
        && request.resource.data.cantidadDisponible >= 0
        && request.resource.data.cantidadDisponible <= resource.data.cantidadInicial
        && (!('insumoNombre' in request.resource.data) || (
          request.resource.data.insumoNombre is string
          && request.resource.data.insumoNombre.size() >= 1
          && request.resource.data.insumoNombre.size() <= 200
        ))
        && (!('costoUnitario' in request.resource.data) || (
          request.resource.data.costoUnitario is number
          && request.resource.data.costoUnitario >= 0
        ))
        && isValidLoteInventarioComun();
      allow delete: if canAdminDeleteTenantDocument();
    }

    function isValidGastoData() {
      return !('id' in request.resource.data)
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() > 0
        && request.resource.data.concepto.size() <= 500
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() > 0
        && request.resource.data.categoria.size() <= 100
        && (
          !('origenFondo' in request.resource.data)
          || request.resource.data.origenFondo in [
            'caja_turno',
            'caja_menor',
            'banco_transferencia',
            'efectivo_externo'
          ]
        )
        && (
          !('metodoPago' in request.resource.data)
          || request.resource.data.metodoPago in ['efectivo', 'transferencia']
        );
    }

    match /gastos/{gastoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument() && isValidGastoData();
      allow update: if canAdminUpdateTenantDocument() && isValidGastoData();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /proveedores/{proveedorId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /facturas_compra/{facturaId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /pagos_facturas/{pagoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /ordenes_compra/{ordenId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /empleados_personal/{empleadoId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /turnos_personal/{turnoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /vales_personal/{valeId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /liquidaciones_nomina/{liquidacionId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /configuraciones_meseros/{configId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /liquidaciones_meseros/{liquidacionId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /promociones/{promocionId} {
      allow read: if canReadTenantDocument()
        || (
          resource.data.activo == true
          && hasTenant(resource.data)
          && tenantIsActive(resource.data.negocioId)
        );
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument()
        || (
          hasTenant(resource.data)
          && hasTenant(request.resource.data)
          && request.resource.data.negocioId == resource.data.negocioId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usosActuales', 'actualizadoEn'])
          && request.resource.data.usosActuales == resource.data.usosActuales + 1
        );
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /bitacora_auditoria/{eventoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      // Bitácora forense inmutable: ningún evento registrado puede alterarse ni borrarse desde cliente.
      allow update, delete: if false;
    }

    match /notificaciones_operativas/{notificacionId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        || (
          hasTenant(request.resource.data)
          && tenantIsActive(request.resource.data.negocioId)
          && request.resource.data.modulo in ['salon', 'pedidos']
          && request.resource.data.keys().hasAll(['negocioId', 'modulo', 'tipo', 'titulo', 'mensaje', 'fecha'])
        );
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /configuraciones_fiscales/{configId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /comprobantes_z/{comprobanteId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument() || canCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /conciliaciones_contables/{conciliacionId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /configuraciones_puc/{docId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /cierres_caja/{cierreId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /cajas/{cajaId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /movimientos_caja/{movimientoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.tipo in ['ingreso_sencillo', 'sangria_caja_fuerte', 'egreso_caja_menor']
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 2;
      allow update: if false;
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /cortes_x/{corteId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.efectivoEsperado is number
        && request.resource.data.efectivoEsperado >= 0
        && request.resource.data.cajeroSaliente is string
        && request.resource.data.cajeroSaliente.size() >= 2;
      allow update: if false;
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /liquidaciones_domiciliarios/{liquidacionId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.estado in ['activa', 'liquidada']
        && request.resource.data.domiciliarioId is string
        && request.resource.data.domiciliarioId.size() >= 1
        && request.resource.data.domiciliarioNombre is string
        && request.resource.data.domiciliarioNombre.size() >= 2
        && request.resource.data.montoBaseInicial is number
        && request.resource.data.montoBaseInicial >= 0
        && request.resource.data.efectivoEsperadoRendir is number
        && request.resource.data.efectivoEsperadoRendir >= 0
        && request.resource.data.efectivoEntregadoFisico is number
        && request.resource.data.efectivoEntregadoFisico >= 0;
      allow update: if canUpdateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.codigoActa == resource.data.codigoActa
        && request.resource.data.domiciliarioId == resource.data.domiciliarioId
        && request.resource.data.montoBaseInicial == resource.data.montoBaseInicial
        && resource.data.estado == 'activa'
        && request.resource.data.estado in ['liquidada', 'anulada']
        && request.resource.data.efectivoEntregadoFisico is number
        && request.resource.data.efectivoEntregadoFisico >= 0;
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /tandas_vitrina/{tandaId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /lista_espera/{turnoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /configuracion/{docId} {
      allow read: if canReadTenantDocument();
      allow create: if request.resource.data.negocioId == docId
        && canAdminCreateTenantDocument();
      allow update: if resource.data.negocioId == docId
        && canAdminUpdateTenantDocument();
      allow delete: if resource.data.negocioId == docId
        && canAdminDeleteTenantDocument();
    }

    match /transacciones_pago/{transaccionId} {
      // Colección histórica desactivada: LaParada no procesa pagos en línea.
      allow read, write: if false;
    }

    match /sesiones_pago/{sesionId} {
      // Colección histórica desactivada: no se crean sesiones de checkout.
      allow read, write: if false;
    }

    match /mensajes_whatsapp/{mensajeId} {
      allow read: if canReadTenantDocument();
      // Entradas, salidas y estados de proveedor solo los escribe el backend.
      // El cliente puede únicamente marcar como leído un mensaje entrante propio.
      allow create, delete: if false;
      allow update: if canUpdateTenantDocument()
        && resource.data.tipo == 'entrada'
        && resource.data.estado == 'entregado'
        && request.resource.data.estado == 'leido'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'actualizadoEn']);
      match /eventos_entrega/{evento} {
        allow read: if exists(/databases/$(database)/documents/mensajes_whatsapp/$(mensajeId))
            && isTenantMember(
              get(/databases/$(database)/documents/mensajes_whatsapp/$(mensajeId)).data.negocioId
            );
        allow create, update, delete: if false;
      }
    }

    // Chat en vivo entre un visitante de la tienda y el negocio.
    //
    // No hay backend propio donde validar, así que el contrato se hace cumplir
    // aquí: el id del documento ES el uid del visitante, de modo que la
    // propiedad se verifica sin leer nada y nadie puede abrir un hilo ajeno.
    function esDuenoDelChat(chatId) {
      return isAuth() && request.auth.uid == chatId;
    }

    function textoChatValido(valor) {
      return valor is string && valor.size() > 0 && valor.size() <= 1200;
    }

    function nombreChatValido(valor) {
      return valor is string && valor.size() >= 2 && valor.size() <= 80;
    }

    // Espeja CHAT_INTERVALO_MINIMO_SEGUNDOS: frena el spam desde el navegador
    // sin necesidad de una Function que lleve la cuenta.
    function respetaIntervaloChat() {
      return request.time > resource.data.ultimoMensajeEn + duration.value(2, 's');
    }

    match /chats/{chatId} {
      allow read: if esDuenoDelChat(chatId) || canReadTenantDocument();

      allow create: if esDuenoDelChat(chatId)
        && hasTenant(request.resource.data)
        && tenantIsActive(request.resource.data.negocioId)
        && request.resource.data.clienteUid == chatId
        && nombreChatValido(request.resource.data.clienteNombre)
        && request.resource.data.estado == 'abierto'
        && request.resource.data.ultimoMensaje == ''
        && request.resource.data.noLeidosAdmin == 0
        && request.resource.data.noLeidosCliente == 0;

      // El visitante solo toca su propio hilo, nunca cambia de negocio ni de
      // dueño, y no puede inflar el contador de no leídos del negocio.
      allow update: if (
          esDuenoDelChat(chatId)
          && request.resource.data.negocioId == resource.data.negocioId
          && request.resource.data.clienteUid == resource.data.clienteUid
          && request.resource.data.creadoEn == resource.data.creadoEn
          && nombreChatValido(request.resource.data.clienteNombre)
          && request.resource.data.estado in ['abierto', 'en_atencion', 'cerrado']
          && request.resource.data.noLeidosAdmin <= resource.data.noLeidosAdmin + 1
          && request.resource.data.noLeidosCliente <= resource.data.noLeidosCliente
          && (
            request.resource.data.ultimoMensajeEn == resource.data.ultimoMensajeEn
            || resource.data.ultimoMensaje == ''
            || respetaIntervaloChat()
          )
        )
        || canUpdateTenantDocument();

      allow delete: if canAdminDeleteTenantDocument();

      match /mensajes/{mensajeId} {
        function chatDelVisitante() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if esDuenoDelChat(chatId)
          || isTenantMember(chatDelVisitante().negocioId);

        allow create: if textoChatValido(request.resource.data.texto)
          && request.resource.data.autorNombre is string
          && request.resource.data.autorNombre.size() <= 80
          && (
            (esDuenoDelChat(chatId) && request.resource.data.autor == 'cliente')
            || (
              isTenantMember(chatDelVisitante().negocioId)
              && request.resource.data.autor == 'asesor'
            )
          );

        // Un mensaje enviado es un hecho: no se reescribe.
        allow update: if false;
        allow delete: if isTenantAdmin(chatDelVisitante().negocioId);
      }
    }

    match /bot_queue/{queueId} {
      allow read, write: if false;
    }

    match /ordenes_pendientes/{ordenId} {
      allow read, write: if false;
    }

    match /_ordenes_whatsapp_activas/{registroId} {
      allow read, write: if false;
    }

    match /pin_attempts/{uid} {
      allow read, write: if false;
    }

    // Centro de Satisfacción del Cliente, Calificación Post-Venta y NPS
    match /encuestas_satisfaccion/{encuestaId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        || (
          hasTenant(request.resource.data)
          && tenantIsActive(request.resource.data.negocioId)
          && request.resource.data.calificacion is number
          && request.resource.data.calificacion >= 1
          && request.resource.data.calificacion <= 5
          && request.resource.data.keys().hasAll(['negocioId', 'calificacion', 'creadoEn'])
        );
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /configuraciones_satisfaccion/{negocioId} {
      allow read: if true;
      allow create, update: if hasTenant(request.resource.data)
        && request.resource.data.negocioId == negocioId
        && isTenantAdmin(negocioId);
      allow delete: if canAdminDeleteTenantDocument();
    }

    // Centro de Metas Comerciales, Presupuesto Operativo Mensual y Punto de Equilibrio
    match /metas_presupuestos/{presupuestoId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    // Tarifario y Zonas de Cobertura de Domicilios
    match /configuraciones_zonas_domicilio/{negocioId} {
      allow read: if tenantIsActive(negocioId) || isTenantMember(negocioId);
      allow create, update: if hasTenant(request.resource.data)
        && request.resource.data.negocioId == negocioId
        && isTenantAdmin(negocioId);
      allow delete: if canAdminDeleteTenantDocument();
    }

    // ===============================================================
    // Bitácora Sanitaria BPM (Resolución 2674 INVIMA)
    // ===============================================================
    // Colecciones aisladas por negocioId:
    // - configuraciones_bpm/{negocioId}: equiposFrio[], freidoras[], plantillas (admin)
    // - registros_temperatura_bpm/{registroId}: lecturas térmicas y cierre de acción correctiva
    // - registros_aceite_bpm/{registroId}: historial inmutable de cambios/inspecciones de aceite
    // - checklists_bpm/{checklistId}: checklists diarios de apertura y cierre de turno
    function isValidConfiguracionBpmData(negocioId) {
      return hasTenant(request.resource.data)
        && request.resource.data.negocioId == negocioId
        && isTenantAdmin(negocioId)
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.equiposFrio is list
        && request.resource.data.equiposFrio.size() <= 100
        && request.resource.data.freidoras is list
        && request.resource.data.freidoras.size() <= 50
        && request.resource.data.plantillaApertura is list
        && request.resource.data.plantillaApertura.size() <= 50
        && request.resource.data.plantillaCierre is list
        && request.resource.data.plantillaCierre.size() <= 50
        && (
          !('actualizadoPor' in request.resource.data)
          || (
            request.resource.data.actualizadoPor is string
            && request.resource.data.actualizadoPor.size() <= 120
          )
        );
    }

    function isValidRegistroTempAccionCorrectivaBpm() {
      return (
          !('resuelto' in request.resource.data)
          || request.resource.data.resuelto is bool
        )
        && (
          !('accionCorrectiva' in request.resource.data)
          || (
            request.resource.data.accionCorrectiva is string
            && request.resource.data.accionCorrectiva.size() <= 500
          )
        )
        && (
          !('resueltoPor' in request.resource.data)
          || (
            request.resource.data.resueltoPor is string
            && request.resource.data.resueltoPor.size() <= 120
          )
        )
        && (
          !('observaciones' in request.resource.data)
          || (
            request.resource.data.observaciones is string
            && request.resource.data.observaciones.size() <= 1000
          )
        );
    }

    function isValidChecklistBpmComun() {
      return !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.tipo in ['apertura', 'cierre']
        && request.resource.data.estado in ['en_progreso', 'completado', 'con_hallazgos']
        && request.resource.data.fechaIso is string
        && request.resource.data.fechaIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 50
        && request.resource.data.porcentajeCumplimiento is number
        && request.resource.data.porcentajeCumplimiento >= 0
        && request.resource.data.porcentajeCumplimiento <= 100
        && (
          !('observacionesGenerales' in request.resource.data)
          || (
            request.resource.data.observacionesGenerales is string
            && request.resource.data.observacionesGenerales.size() <= 1000
          )
        )
        && (
          !('cerradoPor' in request.resource.data)
          || (
            request.resource.data.cerradoPor is string
            && request.resource.data.cerradoPor.size() <= 120
          )
        );
    }

    match /configuraciones_bpm/{negocioId} {
      allow read: if isTenantMember(negocioId);
      allow create, update: if isValidConfiguracionBpmData(negocioId);
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /registros_temperatura_bpm/{registroId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.equipoId is string
        && request.resource.data.equipoId.size() >= 1
        && request.resource.data.equipoId.size() <= 128
        && request.resource.data.equipoNombre is string
        && request.resource.data.equipoNombre.size() >= 1
        && request.resource.data.equipoNombre.size() <= 160
        && request.resource.data.tipoEquipo in ['refrigeracion', 'congelacion', 'caliente']
        && request.resource.data.temperaturaC is number
        && request.resource.data.temperaturaC >= -60
        && request.resource.data.temperaturaC <= 250
        && request.resource.data.estadoConformidad in ['conforme', 'alerta', 'critico']
        && request.resource.data.franja in ['apertura', 'mediodia', 'tarde', 'cierre']
        && request.resource.data.fechaIso is string
        && request.resource.data.fechaIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.responsableNombre is string
        && request.resource.data.responsableNombre.size() >= 2
        && request.resource.data.responsableNombre.size() <= 120
        && (
          !('ubicacion' in request.resource.data)
          || (
            request.resource.data.ubicacion is string
            && request.resource.data.ubicacion.size() <= 160
          )
        )
        && isValidRegistroTempAccionCorrectivaBpm();
      allow update: if canUpdateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.equipoId == resource.data.equipoId
        && request.resource.data.temperaturaC == resource.data.temperaturaC
        && request.resource.data.estadoConformidad == resource.data.estadoConformidad
        && request.resource.data.franja == resource.data.franja
        && request.resource.data.fechaIso == resource.data.fechaIso
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accionCorrectiva', 'resuelto', 'resueltoPor', 'resueltoEn', 'observaciones'
        ])
        && isValidRegistroTempAccionCorrectivaBpm();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /registros_aceite_bpm/{registroId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.freidoraId is string
        && request.resource.data.freidoraId.size() >= 1
        && request.resource.data.freidoraId.size() <= 128
        && request.resource.data.freidoraNombre is string
        && request.resource.data.freidoraNombre.size() >= 1
        && request.resource.data.freidoraNombre.size() <= 160
        && request.resource.data.tipoEvento in ['cambio_completo', 'filtrado', 'inspeccion_calidad', 'reposicion']
        && request.resource.data.colorAceite in ['claro_optimo', 'dorado_aceptable', 'oscuro_vigilar', 'quemado_rechazar']
        && request.resource.data.estadoAceite in ['optimo', 'filtrar_pronto', 'cambiar_inmediato']
        && request.resource.data.fechaIso is string
        && request.resource.data.fechaIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          !('litrosCambiados' in request.resource.data)
          || (
            request.resource.data.litrosCambiados is number
            && request.resource.data.litrosCambiados >= 0
            && request.resource.data.litrosCambiados <= 500
          )
        )
        && request.resource.data.responsableNombre is string
        && request.resource.data.responsableNombre.size() >= 2
        && request.resource.data.responsableNombre.size() <= 120
        && (
          !('loteAceiteNuevo' in request.resource.data)
          || (
            request.resource.data.loteAceiteNuevo is string
            && request.resource.data.loteAceiteNuevo.size() <= 100
          )
        )
        && (
          !('gestorResiduosNombre' in request.resource.data)
          || (
            request.resource.data.gestorResiduosNombre is string
            && request.resource.data.gestorResiduosNombre.size() <= 160
          )
        )
        && (
          !('observaciones' in request.resource.data)
          || (
            request.resource.data.observaciones is string
            && request.resource.data.observaciones.size() <= 1000
          )
        )
        && (
          !('disposicionUsado' in request.resource.data)
          || request.resource.data.disposicionUsado in ['gestor_autorizado', 'bidon_almacenado', 'no_aplica']
        );
      allow update: if false;
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /checklists_bpm/{checklistId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && isValidChecklistBpmComun()
        && request.resource.data.totalItems is number
        && request.resource.data.totalItems >= 1
        && request.resource.data.responsableNombre is string
        && request.resource.data.responsableNombre.size() >= 2
        && request.resource.data.responsableNombre.size() <= 120;
      allow update: if canUpdateTenantDocument()
        && isValidChecklistBpmComun()
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.fechaIso == resource.data.fechaIso
        && (
          !('totalItems' in request.resource.data)
          || (
            request.resource.data.totalItems is number
            && request.resource.data.totalItems >= 1
          )
        )
        && (
          !('responsableNombre' in request.resource.data)
          || (
            request.resource.data.responsableNombre is string
            && request.resource.data.responsableNombre.size() >= 2
            && request.resource.data.responsableNombre.size() <= 120
          )
        );
      allow delete: if canAdminDeleteTenantDocument();
    }

    // ===============================================================
    // Mantenimiento Preventivo de Equipos de Cocina
    // ===============================================================
    // Colecciones aisladas por negocioId:
    // - equipos_mantenimiento/{equipoId}: hoja de vida y estado operativo (admin CRUD; KDS puede reportar falla)
    // - ordenes_mantenimiento/{ordenId}: historial inmutable de órdenes de mantenimiento (admin crea/elimina)
    // - reportes_falla_equipos/{fallaId}: reportes de fallas operativas y resolución (miembros del tenant)
    function isValidIsoDateStringMantenimiento(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidOptionalIsoDateMantenimiento(field) {
      return !(field in request.resource.data)
        || isValidIsoDateStringMantenimiento(request.resource.data[field]);
    }

    function isValidOptionalStringMantenimiento(field, maxLen) {
      return !(field in request.resource.data)
        || (
          request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLen
        );
    }

    function isValidCategoriaEquipoMantenimiento(categoria) {
      return categoria in [
        'coccion',
        'refrigeracion',
        'extraccion',
        'extintor',
        'red_gas',
        'electrico',
        'mobiliario',
        'otro'
      ];
    }

    function isValidEstadoEquipoMantenimiento(estado) {
      return estado in ['operativo', 'en_mantenimiento', 'con_falla', 'fuera_servicio'];
    }

    function isValidEquipoMantenimientoData() {
      return !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.codigoActivo is string
        && request.resource.data.codigoActivo.size() >= 1
        && request.resource.data.codigoActivo.size() <= 40
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 160
        && isValidCategoriaEquipoMantenimiento(request.resource.data.categoria)
        && isValidEstadoEquipoMantenimiento(request.resource.data.estadoOperativo)
        && request.resource.data.frecuenciaPreventivoDias is number
        && request.resource.data.frecuenciaPreventivoDias >= 1
        && request.resource.data.frecuenciaPreventivoDias <= 3650
        && request.resource.data.costoAcumuladoCOP is number
        && request.resource.data.costoAcumuladoCOP >= 0
        && request.resource.data.totalIntervenciones is number
        && request.resource.data.totalIntervenciones >= 0
        && request.resource.data.activo is bool
        && isValidOptionalIsoDateMantenimiento('fechaCompraIso')
        && isValidOptionalIsoDateMantenimiento('garantiaHastaIso')
        && isValidOptionalIsoDateMantenimiento('ultimoMantenimientoIso')
        && isValidOptionalIsoDateMantenimiento('proximoMantenimientoIso')
        && isValidOptionalIsoDateMantenimiento('fechaRecargaVenceIso')
        && isValidOptionalIsoDateMantenimiento('fechaPruebaHidrostaticaIso')
        && isValidOptionalIsoDateMantenimiento('certificadoGasVenceIso')
        && isValidOptionalStringMantenimiento('ubicacion', 160)
        && isValidOptionalStringMantenimiento('marca', 120)
        && isValidOptionalStringMantenimiento('modelo', 120)
        && isValidOptionalStringMantenimiento('numeroSerie', 120)
        && isValidOptionalStringMantenimiento('capacidadExtintor', 80)
        && isValidOptionalStringMantenimiento('empresaCertificadora', 160)
        && isValidOptionalStringMantenimiento('proveedorTecnico', 160)
        && isValidOptionalStringMantenimiento('telefonoTecnico', 40)
        && isValidOptionalStringMantenimiento('notas', 2000)
        && isValidOptionalStringMantenimiento('creadoPor', 120)
        && (
          !('tipoAgenteExtintor' in request.resource.data)
          || request.resource.data.tipoAgenteExtintor in [
            'tipo_k',
            'multiproposito_abc',
            'co2',
            'solkaflam',
            'agua_presion'
          ]
        );
    }

    function isValidOrdenMantenimientoData() {
      return !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.equipoId is string
        && request.resource.data.equipoId.size() >= 1
        && request.resource.data.equipoId.size() <= 128
        && request.resource.data.equipoNombre is string
        && request.resource.data.equipoNombre.size() >= 1
        && request.resource.data.equipoNombre.size() <= 160
        && isValidCategoriaEquipoMantenimiento(request.resource.data.categoriaEquipo)
        && request.resource.data.tipo in [
          'preventivo',
          'correctivo',
          'recarga_extintor',
          'inspeccion_gas',
          'calibracion'
        ]
        && request.resource.data.descripcionTrabajo is string
        && request.resource.data.descripcionTrabajo.size() >= 3
        && request.resource.data.descripcionTrabajo.size() <= 1000
        && isValidIsoDateStringMantenimiento(request.resource.data.fechaIso)
        && request.resource.data.tecnicoNombre is string
        && request.resource.data.tecnicoNombre.size() >= 2
        && request.resource.data.tecnicoNombre.size() <= 120
        && request.resource.data.costoCOP is number
        && request.resource.data.costoCOP >= 0
        && request.resource.data.conciliadoConGasto is bool
        && request.resource.data.responsableNombre is string
        && request.resource.data.responsableNombre.size() >= 2
        && request.resource.data.responsableNombre.size() <= 120
        && isValidEstadoEquipoMantenimiento(request.resource.data.estadoEquipoResultante)
        && isValidOptionalIsoDateMantenimiento('proximaFechaSugeridaIso')
        && isValidOptionalStringMantenimiento('equipoCodigo', 40)
        && isValidOptionalStringMantenimiento('proveedorTecnico', 160)
        && isValidOptionalStringMantenimiento('telefonoTecnico', 40)
        && isValidOptionalStringMantenimiento('numeroFactura', 80)
        && isValidOptionalStringMantenimiento('gastoId', 128)
        && isValidOptionalStringMantenimiento('fallaRelacionadaId', 128)
        && isValidOptionalStringMantenimiento('notas', 2000)
        && (
          !('origenFondoGasto' in request.resource.data)
          || request.resource.data.origenFondoGasto in [
            'caja_turno',
            'caja_menor',
            'banco_transferencia',
            'efectivo_externo'
          ]
        )
        && (
          !('metodoPagoGasto' in request.resource.data)
          || request.resource.data.metodoPagoGasto in ['efectivo', 'transferencia']
        );
    }

    function isValidReporteFallaResolucionMantenimiento() {
      return isValidOptionalStringMantenimiento('resueltoPor', 120)
        && isValidOptionalStringMantenimiento('resolucionNotas', 1000)
        && isValidOptionalStringMantenimiento('ordenMantenimientoId', 128)
        && (
          !('actualizadoEn' in request.resource.data)
          || request.resource.data.actualizadoEn is timestamp
        )
        && (
          !('resueltoEn' in request.resource.data)
          || request.resource.data.resueltoEn is timestamp
        );
    }

    function isValidReporteFallaCreateMantenimiento() {
      return !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.equipoNombre is string
        && request.resource.data.equipoNombre.size() >= 1
        && request.resource.data.equipoNombre.size() <= 160
        && isValidCategoriaEquipoMantenimiento(request.resource.data.categoriaEquipo)
        && request.resource.data.severidad in ['critica', 'alta', 'media', 'baja']
        && request.resource.data.detieneOperacion is bool
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() >= 3
        && request.resource.data.descripcion.size() <= 1000
        && request.resource.data.estado == 'abierta'
        && request.resource.data.origenReporte in [
          'cocina_kds',
          'panel_mantenimiento',
          'dashboard'
        ]
        && isValidIsoDateStringMantenimiento(request.resource.data.fechaIso)
        && request.resource.data.reportadoPor is string
        && request.resource.data.reportadoPor.size() >= 2
        && request.resource.data.reportadoPor.size() <= 120
        && isValidOptionalStringMantenimiento('equipoId', 128)
        && isValidOptionalStringMantenimiento('estacionCocina', 64)
        && isValidOptionalStringMantenimiento('reportadoRol', 40)
        && isValidReporteFallaResolucionMantenimiento();
    }

    match /equipos_mantenimiento/{equipoId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument()
        && isValidEquipoMantenimientoData();
      allow update: if (
          canAdminUpdateTenantDocument()
          && request.resource.data.negocioId == resource.data.negocioId
          && isValidEquipoMantenimientoData()
        )
        || (
          canUpdateTenantDocument()
          && !request.resource.data.keys().hasAny(['id'])
          && request.resource.data.negocioId == resource.data.negocioId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estadoOperativo',
            'actualizadoEn'
          ])
          && request.resource.data.estadoOperativo in ['con_falla', 'fuera_servicio']
          && (
            !('actualizadoEn' in request.resource.data)
            || request.resource.data.actualizadoEn is timestamp
          )
        );
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /ordenes_mantenimiento/{ordenId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument()
        && isValidOrdenMantenimientoData();
      allow update: if false;
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /reportes_falla_equipos/{fallaId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && isValidReporteFallaCreateMantenimiento();
      allow update: if canUpdateTenantDocument()
        && !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.equipoNombre == resource.data.equipoNombre
        && request.resource.data.fechaIso == resource.data.fechaIso
        && request.resource.data.reportadoPor == resource.data.reportadoPor
        && request.resource.data.origenReporte == resource.data.origenReporte
        && request.resource.data.estado in ['abierta', 'en_atencion', 'resuelta', 'descartada']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'actualizadoEn',
          'resueltoEn',
          'resueltoPor',
          'resolucionNotas',
          'ordenMantenimientoId'
        ])
        && isValidReporteFallaResolucionMantenimiento();
      allow delete: if canAdminDeleteTenantDocument();
    }

    // ===============================================================
    // Reclamos, PQRS y Garantías de Pedido (Pago 100% Offline)
    // ===============================================================
    // Colección aislada por negocioId:
    // - reclamos_pqrs/{reclamoId}: radicación, seguimiento SLA y resolución offline trazable (miembros del tenant; eliminación solo admin)
    function isValidOptionalStringReclamos(field, maxLen) {
      return !(field in request.resource.data)
        || (
          request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLen
        );
    }

    function isValidOptionalTimestampReclamos(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] is timestamp;
    }

    function isValidCausaRaizReclamo(causa) {
      return causa in [
        'demora_entrega',
        'pedido_incompleto',
        'producto_equivocado',
        'calidad_temperatura',
        'empaque_derrame',
        'cobro_vueltas',
        'atencion_servicio',
        'otro'
      ];
    }

    function isValidPrioridadReclamo(prioridad) {
      return prioridad in ['critica', 'alta', 'media', 'baja'];
    }

    function isValidSlaObjetivoReclamo(sla) {
      return sla is number
        && sla >= 1
        && sla <= 43200;
    }

    function isValidReclamoPqrsCreate() {
      return !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.codigoRadicado is string
        && request.resource.data.codigoRadicado.size() >= 4
        && request.resource.data.codigoRadicado.size() <= 40
        && request.resource.data.tipo in [
          'reclamo',
          'queja',
          'peticion',
          'sugerencia',
          'garantia_pedido'
        ]
        && request.resource.data.canal in [
          'domicilio',
          'salon',
          'mostrador',
          'whatsapp',
          'web',
          'kiosco'
        ]
        && isValidCausaRaizReclamo(request.resource.data.causaRaiz)
        && isValidPrioridadReclamo(request.resource.data.prioridad)
        && request.resource.data.estado == 'abierto'
        && isValidSlaObjetivoReclamo(request.resource.data.slaObjetivoMin)
        && request.resource.data.clienteNombre is string
        && request.resource.data.clienteNombre.size() >= 2
        && request.resource.data.clienteNombre.size() <= 160
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() >= 5
        && request.resource.data.descripcion.size() <= 1500
        && request.resource.data.montoPedidoCOP is number
        && request.resource.data.montoPedidoCOP >= 0
        && request.resource.data.fechaIso is string
        && request.resource.data.fechaIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.registradoPor is string
        && request.resource.data.registradoPor.size() >= 2
        && request.resource.data.registradoPor.size() <= 120
        && isValidOptionalStringReclamos('clienteTelefono', 40)
        && isValidOptionalStringReclamos('direccionEntrega', 250)
        && isValidOptionalStringReclamos('barrioEntrega', 120)
        && isValidOptionalStringReclamos('domicilioId', 128)
        && isValidOptionalStringReclamos('ventaId', 128)
        && isValidOptionalStringReclamos('mesaNombre', 80)
        && isValidOptionalStringReclamos('repartidorNombre', 120)
        && isValidOptionalStringReclamos('registradoRol', 40)
        && (
          !('itemsAfectados' in request.resource.data)
          || (
            request.resource.data.itemsAfectados is list
            && request.resource.data.itemsAfectados.size() <= 100
          )
        )
        && isValidOptionalTimestampReclamos('creadoEn')
        && isValidOptionalTimestampReclamos('actualizadoEn');
    }

    function isValidReclamoPqrsUpdate() {
      return !request.resource.data.keys().hasAny(['id'])
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.codigoRadicado == resource.data.codigoRadicado
        && request.resource.data.fechaIso == resource.data.fechaIso
        && request.resource.data.registradoPor == resource.data.registradoPor
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'prioridad',
          'slaObjetivoMin',
          'causaRaiz',
          'tipoResolucion',
          'montoCompensacionCOP',
          'resolucionNotas',
          'resueltoEn',
          'resueltoPor',
          'tiempoResolucionMin',
          'cumplioSla',
          'bonoCortesiaId',
          'bonoCortesiaCodigo',
          'movimientoCajaId',
          'movimientoCajaCodigo',
          'reenvioDomicilioId',
          'whatsappEnviadoEn',
          'actualizadoEn'
        ])
        && request.resource.data.estado in [
          'abierto',
          'en_gestion',
          'resuelto',
          'cerrado',
          'descartado'
        ]
        && isValidPrioridadReclamo(request.resource.data.prioridad)
        && isValidSlaObjetivoReclamo(request.resource.data.slaObjetivoMin)
        && isValidCausaRaizReclamo(request.resource.data.causaRaiz)
        && (
          !('tipoResolucion' in request.resource.data)
          || request.resource.data.tipoResolucion in [
            'reenvio_domicilio',
            'bono_cortesia',
            'devolucion_caja',
            'reposicion_salon',
            'disculpa_seguimiento'
          ]
        )
        && (
          !('montoCompensacionCOP' in request.resource.data)
          || (
            request.resource.data.montoCompensacionCOP is number
            && request.resource.data.montoCompensacionCOP >= 0
          )
        )
        && (
          !('tiempoResolucionMin' in request.resource.data)
          || (
            request.resource.data.tiempoResolucionMin is number
            && request.resource.data.tiempoResolucionMin >= 0
          )
        )
        && (
          !('cumplioSla' in request.resource.data)
          || request.resource.data.cumplioSla is bool
        )
        && isValidOptionalStringReclamos('resolucionNotas', 1500)
        && isValidOptionalStringReclamos('resueltoPor', 120)
        && isValidOptionalStringReclamos('bonoCortesiaId', 128)
        && isValidOptionalStringReclamos('bonoCortesiaCodigo', 60)
        && isValidOptionalStringReclamos('movimientoCajaId', 128)
        && isValidOptionalStringReclamos('movimientoCajaCodigo', 60)
        && isValidOptionalStringReclamos('reenvioDomicilioId', 128)
        && isValidOptionalTimestampReclamos('actualizadoEn')
        && isValidOptionalTimestampReclamos('resueltoEn')
        && isValidOptionalTimestampReclamos('whatsappEnviadoEn');
    }

    match /reclamos_pqrs/{reclamoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument()
        && isValidReclamoPqrsCreate();
      allow update: if canUpdateTenantDocument()
        && isValidReclamoPqrsUpdate();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
