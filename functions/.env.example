# Parámetros no secretos de WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_NEGOCIO_ID=laparada

# No guardar secretos en este archivo ni en .env:
# WHATSAPP_ACCESS_TOKEN, WHATSAPP_APP_SECRET y WHATSAPP_WEBHOOK_VERIFY_TOKEN
# se administran en Google Cloud Secret Manager mediante Firebase Functions.
