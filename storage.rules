rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth()
        && request.auth.token.email == 'andres.san1404@gmail.com';
    }

    function profilePath() {
      return /databases/(default)/documents/usuarios_negocio/$(request.auth.uid);
    }

    function hasProfileForTenant(negocioId) {
      return isAuth()
        && firestore.exists(profilePath())
        && firestore.get(profilePath()).data.activo == true
        && firestore.get(profilePath()).data.negocioId == negocioId;
    }

    function tenantIsActive(negocioId) {
      return negocioId == 'laparada'
        || (
          firestore.exists(/databases/(default)/documents/negocios/$(negocioId))
          && firestore.get(/databases/(default)/documents/negocios/$(negocioId)).data.estado == 'activo'
        );
    }

    function isTenantMember(negocioId) {
      return isSuperAdmin()
        || (hasProfileForTenant(negocioId) && tenantIsActive(negocioId));
    }

    function isTenantAdmin(negocioId) {
      return isSuperAdmin()
        || (
          isTenantMember(negocioId)
          && firestore.get(profilePath()).data.rol == 'admin'
        );
    }

    function isValidImage() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Menú público, escritura separada físicamente por tenant.
    match /productos/{negocioId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isTenantAdmin(negocioId) && isValidImage();
      allow delete: if isTenantAdmin(negocioId);
    }

    match /transferencias/{negocioId}/{allPaths=**} {
      allow read: if isTenantMember(negocioId);
      allow create: if isTenantMember(negocioId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isTenantAdmin(negocioId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
